f0f921\"]],\"diverging\":[[0,\"#8e0152\"],[0.1,\"#c51b7d\"],[0.2,\"#de77ae\"],[0.3,\"#f1b6da\"],[0.4,\"#fde0ef\"],[0.5,\"#f7f7f7\"],[0.6,\"#e6f5d0\"],[0.7,\"#b8e186\"],[0.8,\"#7fbc41\"],[0.9,\"#4d9221\"],[1,\"#276419\"]]},\"xaxis\":{\"gridcolor\":\"white\",\"linecolor\":\"white\",\"ticks\":\"\",\"title\":{\"standoff\":15},\"zerolinecolor\":\"white\",\"automargin\":true,\"zerolinewidth\":2},\"yaxis\":{\"gridcolor\":\"white\",\"linecolor\":\"white\",\"ticks\":\"\",\"title\":{\"standoff\":15},\"zerolinecolor\":\"white\",\"automargin\":true,\"zerolinewidth\":2},\"scene\":{\"xaxis\":{\"backgroundcolor\":\"#E5ECF6\",\"gridcolor\":\"white\",\"linecolor\":\"white\",\"showbackground\":true,\"ticks\":\"\",\"zerolinecolor\":\"white\",\"gridwidth\":2},\"yaxis\":{\"backgroundcolor\":\"#E5ECF6\",\"gridcolor\":\"white\",\"linecolor\":\"white\",\"showbackground\":true,\"ticks\":\"\",\"zerolinecolor\":\"white\",\"gridwidth\":2},\"zaxis\":{\"backgroundcolor\":\"#E5ECF6\",\"gridcolor\":\"white\",\"linecolor\":\"white\",\"showbackground\":true,\"ticks\":\"\",\"zerolinecolor\":\"white\",\"gridwidth\":2}},\"shapedefaults\":{\"line\":{\"color\":\"#2a3f5f\"}},\"annotationdefaults\":{\"arrowcolor\":\"#2a3f5f\",\"arrowhead\":0,\"arrowwidth\":1},\"geo\":{\"bgcolor\":\"white\",\"landcolor\":\"#E5ECF6\",\"subunitcolor\":\"white\",\"showland\":true,\"showlakes\":true,\"lakecolor\":\"white\"},\"title\":{\"x\":0.05},\"margin\":{\"b\":0,\"l\":0,\"r\":0,\"t\":30}}},\"xaxis\":{\"anchor\":\"y\",\"domain\":[0.0,1.0],\"title\":{\"text\":\"N\"},\"type\":\"log\"},\"yaxis\":{\"anchor\":\"x\",\"domain\":[0.0,1.0],\"title\":{\"text\":\"forward time [s]\"},\"type\":\"log\"},\"legend\":{\"title\":{\"text\":\"implementation\"},\"tracegroupgap\":0},\"title\":{\"text\":\"Forward time vs number of particles\"}},                        {\"responsive\": true}                    )                };            </script>        </div>\n```\n:::\n:::\n\n\n## What this shows\n\n**CPU, $N = 10^7$.** The gradient takes 3\\.18 s with\nEnzyme's compacting loop, 4\\.82 s with\nJAX's `nonzero(size=cap)`, and 11\\.99 s\nwith JAX's masked version, which deposits all $N$ particles at every step with zero\nweight. Compaction pays off in JAX too, but there it needs a capacity, a host-side\ncheck, and a recompilation whenever the capacity changes.\n\n**Memory is where masking really hurts.** Reverse mode through the 50-step `scan`\nkeeps each step's residuals. For the masked version that is all $N$ particles per step;\nfor the compacted version and for Enzyme, only the selected ones.\n\n::: {#1eda83b7 .cell execution_count=5}\n\n::: {.cell-output .cell-output-display execution_count=5}\n```{=html}\n<style type=\"text/css\">\n</style>\n<table id=\"T_8dc74\">\n  <caption>Gradient memory [MiB]. Enzyme: host bytes allocated by the call. JAX: XLA temp buffers.</caption>\n  <thead>\n    <tr>\n      <th class=\"blank level0\" >&nbsp;</th>\n      <th id=\"T_8dc74_level0_col0\" class=\"col_heading level0 col0\" >N = 1e+04</th>\n      <th id=\"T_8dc74_level0_col1\" class=\"col_heading level0 col1\" >N = 1e+05</th>\n      <th id=\"T_8dc74_level0_col2\" class=\"col_heading level0 col2\" >N = 1e+06</th>\n      <th id=\"T_8dc74_level0_col3\" class=\"col_heading level0 col3\" >N = 1e+07</th>\n    </tr>\n    <tr>\n      <th class=\"index_name level0\" >implementation</th>\n      <th class=\"blank col0\" >&nbsp;</th>\n      <th class=\"blank col1\" >&nbsp;</th>\n      <th class=\"blank col2\" >&nbsp;</th>\n      <th class=\"blank col3\" >&nbsp;</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th id=\"T_8dc74_level0_row0\" class=\"row_heading level0 row0\" >enzyme (cpu)</th>\n      <td id=\"T_8dc74_row0_col0\" class=\"data row0 col0\" >0.1</td>\n      <td id=\"T_8dc74_row0_col1\" class=\"data row0 col1\" >0.8</td>\n      <td id=\"T_8dc74_row0_col2\" class=\"data row0 col2\" >7.9</td>\n      <td id=\"T_8dc74_row0_col3\" class=\"data row0 col3\" >78.0</td>\n    </tr>\n    <tr>\n      <th id=\"T_8dc74_level0_row1\" class=\"row_heading level0 row1\" >jax / compacted (cpu)</th>\n      <td id=\"T_8dc74_row1_col0\" class=\"data row1 col0\" >0.6</td>\n      <td id=\"T_8dc74_row1_col1\" class=\"data row1 col1\" >5.8</td>\n      <td id=\"T_8dc74_row1_col2\" class=\"data row1 col2\" >57.5</td>\n      <td id=\"T_8dc74_row1_col3\" class=\"data row1 col3\" >567.3</td>\n    </tr>\n    <tr>\n      <th id=\"T_8dc74_level0_row2\" class=\"row_heading level0 row2\" >jax / compacted (gpu)</th>\n      <td id=\"T_8dc74_row2_col0\" class=\"data row2 col0\" >0.3</td>\n      <td id=\"T_8dc74_row2_col1\" class=\"data row2 col1\" >2.8</td>\n      <td id=\"T_8dc74_row2_col2\" class=\"data row2 col2\" >27.9</td>\n      <td id=\"T_8dc74_row2_col3\" class=\"data row2 col3\" >271.2</td>\n    </tr>\n    <tr>\n      <th id=\"T_8dc74_level0_row3\" class=\"row_heading level0 row3\" >jax / masked (cpu)</th>\n      <td id=\"T_8dc74_row3_col0\" class=\"data row3 col0\" >24.1</td>\n      <td id=\"T_8dc74_row3_col1\" class=\"data row3 col1\" >240.7</td>\n      <td id=\"T_8dc74_row3_col2\" class=\"data row3 col2\" >2,407.1</td>\n      <td id=\"T_8dc74_row3_col3\" class=\"data row3 col3\" >24,070.7</td>\n    </tr>\n    <tr>\n      <th id=\"T_8dc74_level0_row4\" class=\"row_heading level0 row4\" >jax / masked (gpu)</th>\n      <td id=\"T_8dc74_row4_col0\" class=\"data row4 col0\" >23.9</td>\n      <td id=\"T_8dc74_row4_col1\" class=\"data row4 col1\" >240.3</td>\n      <td id=\"T_8dc74_row4_col2\" class=\"data row4 col2\" >2,403.3</td>\n      <td id=\"T_8dc74_row4_col3\" class=\"data row4 col3\" >24,032.6</td>\n    </tr>\n  </tbody>\n</table>\n```\n:::\n:::\n\n\nOn the GPU (16 GB) the masked JAX gradient **runs out of memory at $N = 10^7$**:\n\n::: {#f29ecb4c .cell execution_count=6}\n\n::: {.cell-output .cell-output-stdout}\n```\njax / masked (gpu), N = 10,000,000: RESOURCE_EXHAUSTED: Out of memory while trying to allocate 23.47GiB with allocator GPU_0_bfc on device 0.\n```\n:::\n:::\n\n\n## Where JAX wins / what we did not do\n\n::: {.callout-note}\n**On the GPU, JAX's compacted version is the fastest.** At $N = 10^7$ the gradient\ntakes 52\\.6 ms with JAX against\n146\\.9 ms with Enzyme. On a GPU every implementation\ntests all $N$ particles at every step. Enzyme's kernel lets threads outside the window\nreturn immediately and scatters the rest with atomic adds, while XLA's `nonzero`\ncompaction followed by a dense deposit on ~1 % of the particles is faster here.\nGetting there in JAX required knowing the `nonzero(size=…)` idiom and computing the\ncapacity outside `jit`.\n:::\n\n- Neither side sorts particles by position, which would make the selection itself\n  $O(\\text{selected})$ instead of $O(N)$ per step.\n- No Enzyme GPU compaction (a stream-compaction kernel before the deposit), which is\n  what a CUDA programmer would write.\n- No Reactant column on this page yet.\n\n",
